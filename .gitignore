# ============================================================
# D&D 3R CHM → TiddlyWiki 迁移工程
# 目标：避免仓库臃肿（约 480 MB）与泄露本地环境/凭证
# ============================================================

# ------------------------------------------------------------
# 1. IDE / 编辑器（含本地绝对路径，属隐私）
# ------------------------------------------------------------
.vscode/*
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------
# 2. AI 辅助工具运行数据（.dsh-meow）
#    含会话记录 memory.db 与 sessions/*.json，可能包含对话内容与本地路径，
#    属隐私数据，一律不入库。
# ------------------------------------------------------------
.dsh-meow/
.codebuddy/teams/

# ------------------------------------------------------------
# 3. Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------
# 4. Node.js（meow-review 插件副本等；node_modules 为 junction，
#    指向仓库内目录，不应入库）
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ------------------------------------------------------------
# 5. 凭证 / 密钥 / 环境变量（防泄露，最高优先级）
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.keystore
.secrets/
secrets/
**/credentials*
**/*credential*
**/*secret*
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.htpasswd
.netrc
*.token
auth.json

# ------------------------------------------------------------
# 6. 数据库 / 缓存（本地运行态，含会话数据）
# ------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# ------------------------------------------------------------
# 7. 操作系统
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
._*

# ------------------------------------------------------------
# 8. CHM 编译残留（二进制，无源码价值，共约 24 MB）
#    这些是 CHM 解压产物，不是工程内容。
# ------------------------------------------------------------
# 注意：这些文件名以 # 开头，而 # 在 .gitignore 中是注释符，
# 必须转义为 \# 才能生效（否则整行被当作注释忽略）。
\#IDXHDR
\#ITBITS
\#IVB
\#STRINGS
\#SYSTEM
\#TOPICS
\#URLSTR
\#URLTBL
\#WINDOWS
$FIftiMain
$OBJINST
$WWAssociativeLinks/
$WWKeywordLinks/
# 注意：Contents.hhc / Index.hhk 是目录树源文件，需入库（见下方 ! 规则）

# ------------------------------------------------------------
# 8.5 DSH 插件源码副本（第三方仓库的本地副本，内含独立 .git）
#     若入库会被 Git 存为 submodule gitlink，clone 后得到无法解析的空链接。
#     本地文件保留，node_modules junction 仍指向此处，不影响运行。
# ------------------------------------------------------------
transport/work/meow-review/billing/
transport/work/meow-review/memory-openssl/
# 防御：任何含独立 .git 的目录都不入库。第三方源码副本一律视为外部依赖，
# 本地保留即可（node_modules junction 指向此处，运行不受影响）。
# 新增插件副本时无需改本文件，此规则自动覆盖。
**/meow-review/*/.git/

# ------------------------------------------------------------
# 9. 迁移中间产物（可由脚本重新生成）
#    work/converted/ 为转换中间态；备份文件为操作前的副本，
#    体积大且可重建，不入库。
# ------------------------------------------------------------
transport/work/converted/
transport/work/backup_spans_20260831/
*.bak
*.csv.bak
*.csv.*-backup
*.csv.*-backup2
*.csv.old-title-format
*.csv.pre-rootfix
*.csv.pre-10fix

# ------------------------------------------------------------
# 10. TiddlyWiki 运行态（单文件导出、自动生成文件）
#     tiddlers/ 是核心交付物，必须入库，不在此排除。
# ------------------------------------------------------------
transport/wiki/output/
transport/wiki/*.html
!transport/wiki/tiddlers/**

# ------------------------------------------------------------
# 11. 临时 / 调试文件
# ------------------------------------------------------------
*.tmp
*.temp
*.orig
*.rej
*.diff
*.patch
test-style-render.html

# ============================================================
# 显式保留（防止被上述规则误伤）
# ============================================================
# CHM 目录树源文件：generate_toc.py 依赖，必须入库
!Contents.hhc
!Index.hhk
# 工程文档
!**/*.md
# 迁移脚本
!transport/work/*.py
# 映射表主文件（备份已排除，主文件需入库）
!transport/work/final_mapping.csv
!transport/work/hhc_mapping.csv
!transport/work/inventory.csv
!transport/work/link-report.csv
