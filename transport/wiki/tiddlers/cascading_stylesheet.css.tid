title: cascading_stylesheet.css
tags: $:/tags/Stylesheet
type: text/css

.tc-tiddler-body {
font-family: Segoe UI,'微软雅黑',sans-serif;
font-size: 87.5%;
}
.tc-tiddler-body h1{font-size: 2.25em; font-weight: bold; color: maroon; margin-bottom: 0.3em; margin-top: 0.2em;}
.tc-tiddler-body h2{font-size: 2em; font-weight: bold; color: maroon; margin-bottom: 0.3em; margin-top: 0.2em;}
.tc-tiddler-body h3{font-size: 1.75em; font-weight: bold; color: maroon; margin-bottom: 0.3em; margin-top: 0.2em;}
.tc-tiddler-body h4{font-size: 1.5em; font-weight: bold; color: maroon; margin-bottom: 0.3em; margin-top: 0.2em;}
.tc-tiddler-body h5{font-size: 1.25em; font-weight: bold; color: maroon; margin-bottom: 0.3em; margin-top: 0.2em;}
.tc-tiddler-body h6{font-size: 1.13em; font-weight: bold; color: maroon; margin-bottom: 0.3em; margin-top: 0.2em;}
.tc-tiddler-body .subhead {font-style: italic;}
.tc-tiddler-body p{ font-size: 1em; margin-bottom: 0.3em; margin-top: 0.2em; text-indent: 2em; }
.tc-tiddler-body .noindent {text-indent: 0;}
.tc-tiddler-body .noidt {text-indent: 0;}
.tc-tiddler-body table {font-size: 1em; border: black 1px solid; border-collapse: collapse;}
.tc-tiddler-body td{border: black 1px solid; padding-left: 0.2em; padding-right: 0.2em;}
.tc-tiddler-body th{border: black 1px solid; padding-left: 0.2em; padding-right: 0.2em; font-weight: bold;}
.tc-tiddler-body ul{font-size: 1em; margin-left: 0; padding-left: 1.5em; margin-bottom: 0.3em; margin-top: 0.2em;}
.tc-tiddler-body li{text-indent: 0;}
