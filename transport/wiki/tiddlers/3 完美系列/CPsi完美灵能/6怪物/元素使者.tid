<table><tr><td><b>生命骰：</b></td><td>3HD(13hp)</td></tr><tr><td><b>先攻：</b></td><td>+7</td></tr><tr><td><b>速度：</b></td><td>飞行30呎(完美，6格)</td></tr><tr><td><b>防御等级：</b></td><td>17，接触14，措手不及14</td></tr><tr><td><b>基本攻击/擒抱：</b></td><td>+2/-2</td></tr><tr><td><b>攻击：</b></td><td>攻击+6近战(1d4)</td></tr><tr><td><b>面宽/触及：</b></td><td>5尺/5尺</td></tr><tr><td><b>特殊攻击：</b></td><td>类灵能能力(显能等级：2级) 2次/天——能量射线(电击，+5远程接触，2d6伤害)，打压士气(DC12)，操控气流(最大可变风速为30哩/时)</td></tr><tr><td><b>特殊能力：</b></td><td>元素生物特性</td></tr><tr><td><b>豁免：</b></td><td>强韧+1，反射+6，意志+1</td></tr><tr><td><b>属性：</b></td><td>力量10，敏捷17，体质10，智力12，感知11，魅力12</td></tr><tr><td><b>技能：</b></td><td>专注+7，收集信息+7,聆听+0，辨识灵能+7，侦察+0</td></tr><tr><td><b>语言：</b></td><td>通用语，风族语</td></tr><tr><td><b>专长：</b></td><td>战斗显能，飞越攻击，精通先攻，强化天生武器，武器娴熟</td></tr><tr><td><b>挑战等级：</b></td><td>2</td></tr></table>

