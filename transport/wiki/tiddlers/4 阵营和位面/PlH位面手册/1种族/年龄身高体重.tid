<table><tr><td></td><td></td><td></td><td>吟游诗人</td><td>牧师</td></tr><tr><td></td><td></td><td>野蛮人</td><td>战士</td><td>德鲁伊</td></tr><tr><td></td><td></td><td>游荡者</td><td>圣武士</td><td>武僧</td></tr><tr><td><b>种族</b></td><td><b>成年</b></td><td>术士</td><td>巡林客</td><td>法师</td></tr><tr><td>阿斯莫</td><td>15岁</td><td>+1d6</td><td>+1d8</td><td>+2d8</td></tr><tr><td>半羊人</td><td>20岁</td><td>+1d6</td><td>+2d6</td><td>+3d6</td></tr><tr><td>布曼人</td><td>15岁</td><td>+1d4</td><td>+1d6</td><td>+2d6</td></tr><tr><td>魔蝠人</td><td>50岁</td><td>+4d4</td><td>+4d6</td><td>+6d6</td></tr><tr><td>涅拉蟾</td><td>40岁</td><td>+3d6</td><td>+5d6</td><td>+7d6</td></tr><tr><td>迅影裔</td><td>12岁</td><td>+1d4</td><td>+2d4</td><td>+3d4</td></tr><tr><td>刺修罗</td><td>20岁</td><td>+1d4</td><td>+1d6</td><td>+2d6</td></tr><tr><td>泰夫林</td><td>15岁</td><td>+1d6</td><td>+1d8</td><td>+2d8</td></tr></table>

