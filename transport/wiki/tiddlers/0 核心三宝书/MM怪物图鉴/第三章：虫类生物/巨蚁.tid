<tr><td>生命骰</td><td>2d8 (9HP)</td><td>2d8+2 (11HP)</td><td>4d8+4 (22HP)</td></tr>
<tr><td>先攻</td><td>+0</td><td>+0</td><td>-1</td></tr>
