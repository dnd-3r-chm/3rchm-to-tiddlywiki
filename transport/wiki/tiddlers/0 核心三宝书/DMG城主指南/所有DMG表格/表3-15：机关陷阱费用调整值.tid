<div class="container">
    <div>表3-15：机关陷阱费用调整值</div>
    <table>
        <thead><tr><th style="width:58%">特色</th><th style="width:42%">费用调整值</th></tr></thead>
        <tbody>
            <tr><td class="feature cat">触发类型</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">位置</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">邻近程度</td><td class="cost">+1,000金币</td></tr>
            <tr><td class="feature sub">接触</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">接触(攀附)</td><td class="cost">100金币</td></tr>
            <tr><td class="feature sub">定时</td><td class="cost">+1,000金币</td></tr>
            <tr><td class="feature cat">重新作用类型</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">无法重新作用</td><td class="cost">500金币</td></tr>
            <tr><td class="feature sub">修复后</td><td class="cost">200金币</td></tr>
            <tr><td class="feature sub">手动</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">自动</td><td class="cost">+500金币(若陷阱属定时触发则为0)</td></tr>
            <tr><td class="feature cat">回避类型</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">锁</td><td class="cost">+100金币("开锁"DC=30)</td></tr>
            <tr><td class="feature sub">隐藏开关</td><td class="cost">+200金币("搜索"DC=25)</td></tr>
            <tr><td class="feature sub">隐藏锁</td><td class="cost">+300金币("开锁"DC=30，"搜索"DC=25)</td></tr>
            <tr><td class="feature cat">"搜索"DC</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">19以下</td><td class="cost">100金币×(20DC)</td></tr>
            <tr><td class="feature sub">20</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">21以上</td><td class="cost">+200金币×(DC20)</td></tr>
            <tr><td class="feature cat">"解除装置"DC</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">19以下</td><td class="cost">100金币×(20DC)</td></tr>
            <tr><td class="feature sub">20</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">21以上</td><td class="cost">+200金币×(DC20)</td></tr>
            <tr><td class="feature cat">反射检定DC(陷坑或其他需进行豁免检定的陷阱)</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">19以下</td><td class="cost">100金币×(20DC)</td></tr>
            <tr><td class="feature sub">20</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">20以上</td><td class="cost">+300金币×(DC20)</td></tr>
            <tr><td class="feature cat">攻击加值(近战或远程攻击陷阱)</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">+9以下</td><td class="cost">100金币×(10加值)</td></tr>
            <tr><td class="feature sub">+10</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">+11以上</td><td class="cost">+200金币×(加值10)</td></tr>
            <tr><td class="feature cat">伤害加值</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">高力量值(远程攻击陷阱)</td><td class="cost">+100金币×加值(至多+4)</td></tr>
            <tr><td class="feature sub">高力量加值(近战攻击陷阱)</td><td class="cost">+100金币×加值(至多+8)</td></tr>
            <tr><td class="feature cat">其他特色</td><td class="cost empty">—</td></tr>
            <tr><td class="feature sub">从不失手</td><td class="cost">+1,000金币</td></tr>
            <tr><td class="feature sub">毒素</td><td class="cost">毒素费用(见表8-3)(注一)</td></tr>
            <tr><td class="feature sub">炼金物品</td><td class="cost">物品费用(见《玩家手册》表7-8)</td></tr>
        </tbody>
    </table>
    <div class="notes">
        <p>(注一)若陷阱为自动重新作用需×20。</p>
    </div>
</div>