<div>
    <div>表3-15：机关陷阱费用调整值</div>
    <table>
        <thead><tr><th>特色</th><th>费用调整值</th></tr></thead>
        <tbody>
            <tr><td>触发类型</td><td>—</td></tr>
            <tr><td>位置</td><td>—</td></tr>
            <tr><td>邻近程度</td><td>+1,000金币</td></tr>
            <tr><td>接触</td><td>—</td></tr>
            <tr><td>接触(攀附)</td><td>100金币</td></tr>
            <tr><td>定时</td><td>+1,000金币</td></tr>
            <tr><td>重新作用类型</td><td>—</td></tr>
            <tr><td>无法重新作用</td><td>500金币</td></tr>
            <tr><td>修复后</td><td>200金币</td></tr>
            <tr><td>手动</td><td>—</td></tr>
            <tr><td>自动</td><td>+500金币(若陷阱属定时触发则为0)</td></tr>
            <tr><td>回避类型</td><td>—</td></tr>
            <tr><td>锁</td><td>+100金币("开锁"DC=30)</td></tr>
            <tr><td>隐藏开关</td><td>+200金币("搜索"DC=25)</td></tr>
            <tr><td>隐藏锁</td><td>+300金币("开锁"DC=30，"搜索"DC=25)</td></tr>
            <tr><td>"搜索"DC</td><td>—</td></tr>
            <tr><td>19以下</td><td>100金币×(20DC)</td></tr>
            <tr><td>20</td><td>—</td></tr>
            <tr><td>21以上</td><td>+200金币×(DC20)</td></tr>
            <tr><td>"解除装置"DC</td><td>—</td></tr>
            <tr><td>19以下</td><td>100金币×(20DC)</td></tr>
            <tr><td>20</td><td>—</td></tr>
            <tr><td>21以上</td><td>+200金币×(DC20)</td></tr>
            <tr><td>反射检定DC(陷坑或其他需进行豁免检定的陷阱)</td><td>—</td></tr>
            <tr><td>19以下</td><td>100金币×(20DC)</td></tr>
            <tr><td>20</td><td>—</td></tr>
            <tr><td>20以上</td><td>+300金币×(DC20)</td></tr>
            <tr><td>攻击加值(近战或远程攻击陷阱)</td><td>—</td></tr>
            <tr><td>+9以下</td><td>100金币×(10加值)</td></tr>
            <tr><td>+10</td><td>—</td></tr>
            <tr><td>+11以上</td><td>+200金币×(加值10)</td></tr>
            <tr><td>伤害加值</td><td>—</td></tr>
            <tr><td>高力量值(远程攻击陷阱)</td><td>+100金币×加值(至多+4)</td></tr>
            <tr><td>高力量加值(近战攻击陷阱)</td><td>+100金币×加值(至多+8)</td></tr>
            <tr><td>其他特色</td><td>—</td></tr>
            <tr><td>从不失手</td><td>+1,000金币</td></tr>
            <tr><td>毒素</td><td>毒素费用(见表8-3)(注一)</td></tr>
            <tr><td>炼金物品</td><td>物品费用(见《玩家手册》表7-8)</td></tr>
        </tbody>
    </table>
    <div>
        <p>(注一)若陷阱为自动重新作用需×20。</p>
    </div>
</div>